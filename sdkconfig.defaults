# Perceptio 2.0 bring-up — ESP32-S3-MINI-1-N4R2
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Console over the native USB-Serial-JTAG (pogo D+/D-)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# In-package quad PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=6144

# Keep both cores free of surprises during tests
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# Core dump to the 64 KB coredump partition (ELF, crashed task + a few others); the summary is published as a
# `crash` event at the next boot (cloud.c crash_report) and the image erased — so a reboot explains itself remotely.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=6
CONFIG_ESP_COREDUMP_STACK_SIZE=1024

# Core split: everything network/UI on core 0, capture on core 1
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# WebSocket support in esp_http_server (live plots)
CONFIG_HTTPD_WS_SUPPORT=y

# Cloud link: MQTT 5 over WebSocket/TLS, client task on core 0, TLS trust from the IDF certificate bundle
CONFIG_MQTT_PROTOCOL_5=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=y
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_LWIP_SNTP_UPDATE_DELAY=600000
# TLS memory: plain malloc, so the PSRAM-malloc threshold decides — the 4 KB output buffers (and everything < 6 KB)
# stay internal so hardware AES works in place (no DMA bounce copy); the 16 KB input buffers and the 8 KB MQTT
# buffers go to PSRAM. (External-only allocation cost a bounce buffer per record and ~120 KB/s.)
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# Upload throughput (docs/firmware-upload-speed.md §2): the 5.7 KB default windows cap one TLS stream at ~110-190 KB/s
# through Cloudflare (one window per RTT). Wi-Fi/lwIP buffers in PSRAM: otherwise the 64 KB send window + TX buffers eat
# the internal heap and the hardware AES driver, which needs an internal DMA bounce buffer per TLS record, fails
# ("esp-aes: Failed to allocate memory" -> dropped connection). TLS records stay 4 KB for the same reason.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# with Wi-Fi buffers in PSRAM, IDF adds internal 'cache TX buffers' (default 32 x 1.6 KB = 51 KB!): keep the minimum
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# Internal RAM: task stacks of non-critical tasks in PSRAM (include/task_psram.h), fewer static Wi-Fi RX buffers,
# more lwIP sockets (MQTT + HTTP server + mDNS exceeded the default 10: "httpd accept error 23")
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_LWIP_MAX_SOCKETS=16
# 240 MHz: TLS + lwIP + Wi-Fi driver on core 0 are CPU-bound at 160 MHz (upload capped ~380 KB/s with 64 KB windows)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
# Wi-Fi TX/RX block-ack windows as in the IDF iperf example (default 6)
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=16
